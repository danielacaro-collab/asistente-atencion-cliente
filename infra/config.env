# Configuración del despliegue. NO pongas credenciales aquí: los scripts usan la
# sesión activa de AWS CLI (AWS CloudShell o ~/.aws/credentials local, fuera del repo).

PROYECTO="asistente-tecnohogar"
AWS_REGION="${AWS_REGION:-us-east-1}"     # Learner Lab: us-east-1 (o us-west-2)
LAB_ROLE_NAME="LabRole"                   # rol preexistente del Learner Lab

# Recursos (los buckets reciben como sufijo el ID de la cuenta para ser únicos)
KB_TABLE="${PROYECTO}-kb"
LOG_TABLE="${PROYECTO}-consultas"
RATE_TABLE="${PROYECTO}-limites"
LAMBDA_NAME="${PROYECTO}-fn"
API_NAME="${PROYECTO}-api"
DASHBOARD_NAME="${PROYECTO}-dashboard"
METRIC_NAMESPACE="AsistenteAtencionCliente"

# Parámetros de la aplicación
UMBRAL_RESPUESTA="0.38"     # score mínimo para responder con certeza
UMBRAL_SUGERENCIA="0.22"    # entre ambos umbrales: se sugiere la pregunta más parecida
LIMITE_POR_MINUTO="30"      # consultas por cliente por minuto (la prueba de aceptación envía 25)
MAX_CARACTERES="500"
LOG_TTL_DIAS="30"           # las consultas registradas se borran solas a los 30 días
LOG_RETENCION_DIAS="7"      # retención de CloudWatch Logs

# Throttling de API Gateway (límite global de la etapa $default)
API_RATE_LIMIT="5"          # solicitudes por segundo
API_BURST_LIMIT="10"
