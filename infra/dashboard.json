{
  "widgets": [
    {
      "type": "metric", "x": 0, "y": 0, "width": 12, "height": 6,
      "properties": {
        "title": "Consultas por resultado",
        "region": "us-east-1", "view": "timeSeries", "stacked": true, "stat": "Sum", "period": 300,
        "metrics": [
          ["AsistenteAtencionCliente", "Respondidas", "Servicio", "asistente"],
          [".", "SinRespuesta", ".", "."],
          [".", "Rechazadas", ".", "."]
        ]
      }
    },
    {
      "type": "metric", "x": 12, "y": 0, "width": 12, "height": 6,
      "properties": {
        "title": "Score de similitud promedio y latencia",
        "region": "us-east-1", "view": "timeSeries", "period": 300,
        "metrics": [
          ["AsistenteAtencionCliente", "ScoreSimilitud", "Servicio", "asistente", {"stat": "Average"}],
          [".", "LatenciaMs", ".", ".", {"stat": "p90", "yAxis": "right"}]
        ]
      }
    },
    {
      "type": "metric", "x": 0, "y": 6, "width": 12, "height": 6,
      "properties": {
        "title": "Lambda: invocaciones, errores y throttles",
        "region": "us-east-1", "view": "timeSeries", "stat": "Sum", "period": 300,
        "metrics": [
          ["AWS/Lambda", "Invocations", "FunctionName", "asistente-tecnohogar-fn"],
          [".", "Errors", ".", "."],
          [".", "Throttles", ".", "."]
        ]
      }
    },
    {
      "type": "log", "x": 12, "y": 6, "width": 12, "height": 6,
      "properties": {
        "title": "Últimas consultas sin respuesta",
        "region": "us-east-1", "view": "table",
        "query": "SOURCE '/aws/lambda/asistente-tecnohogar-fn' | fields @timestamp, Estado, ScoreSimilitud, Origen | filter Estado = 'sin_respuesta' or Estado = 'sugerencia' | sort @timestamp desc | limit 20"
      }
    }
  ]
}
